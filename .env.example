# Root environment template. Copy to `.env` for local development and keep real
# values out of git. Each app also has its own `.env.example` with the variables
# it reads; this file lists them all in one place.
#
#   [Required]  must be set in production
#   [Optional]  has a default or the feature is off when unset

# ── API (apps/api) ──────────────────────────────────────────────────────────
PORT=4000
# [Required] PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qyou?schema=public"
# [Required] access-token signing secret — long and random in production
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="1h"
# bcrypt cost factor, must be >= 12
BCRYPT_SALT_ROUNDS="12"

# ── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"

# ── Mobile (apps/mobile) ────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:4000"

# ── Stellar (packages/stellar) ──────────────────────────────────────────────
# [Optional] TESTNET (default) or MAINNET; mainnet also needs STELLAR_ALLOW_MAINNET=true
STELLAR_NETWORK="TESTNET"
HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_ALLOW_MAINNET="false"
FORCE_PRODUCTION_STELLAR="false"
STELLAR_INCENTIVES_ENABLED="false"
# [Required for payouts] distribution account secret — never commit a real value
STELLAR_DISTRIBUTION_SECRET_KEY=""
STELLAR_INCENTIVE_POOL_CONTRACT_ID=""

# ── Alerting (packages/stellar/src/monitoring) ──────────────────────────────
# [Optional] Slack incoming-webhook URL; alerts are not sent when unset
SLACK_WEBHOOK_URL=""
