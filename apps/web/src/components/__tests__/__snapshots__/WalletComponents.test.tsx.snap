exports[`Stellar Web UI Components - Wallet & Reward State Snapshot Tests (#1047) WalletBalanceCard (#1047) 2. Error State: renders error alert with message and retry button on fetch rejection 1`] = `
<div>
  <div
    data-testid="wallet-balance-error"
    role="alert"
    style="border-radius: 8px; padding: 24px; background-color: rgb(254, 242, 242); border: 1px solid #fecaca; color: rgb(153, 27, 27);"
  >
    <h4
      style="margin: 0px 0px 8px 0px; font-size: 16px; font-weight: 600;"
    >
      Unable to Load Wallet
    </h4>
    <p
      style="font-size: 14px; margin: 0px 0px 16px 0px;"
    >
      Horizon RPC unreachable or offline
    </p>
    <button
      aria-busy="false"
      aria-disabled="false"
      style="background-color: rgb(220, 38, 38); color: rgb(255, 255, 255);"
      type="button"
    >
      Retry
    </button>
  </div>
</div>
`;

