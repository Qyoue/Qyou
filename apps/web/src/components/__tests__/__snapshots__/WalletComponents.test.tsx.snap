exports[`Stellar Web UI Components - Wallet & Reward State Snapshot Tests (#1047) WalletSetup (#1047) 1. Initial Choose State: renders setup options (connect vs generate) 1`] = `
<div>
  <div
    data-testid="wallet-setup-container"
    style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px; background-color: rgb(255, 255, 255);"
  >
    <h2
      style="font-size: 18px; font-weight: 600; margin-bottom: 8px;"
    >
      Set Up Your Stellar Wallet
    </h2>
    <p
      style="font-size: 14px; color: rgb(107, 114, 128); margin-bottom: 20px;"
    >
      Connect or create a Stellar account to receive queue incentive rewards directly on-chain.
    </p>
    <div
      style="display: flex; flex-direction: column; gap: 12px;"
    >
      <div
        data-testid="choose-custodial"
        style="padding: 16px; border: 1px solid #d1d5db; border-radius: 6px; cursor: pointer;"
      >
        <h4
          style="margin: 0px; font-size: 15px; color: rgb(17, 24, 39);"
        >
          Option A: Automated Custodial Wallet (Recommended)
        </h4>
        <p
          style="margin: 4px 0px 0px 0px; font-size: 13px; color: rgb(107, 114, 128);"
        >
          Qyou manages the keys automatically. Ideal if you don’t already have a Stellar wallet.
        </p>
      </div>
      <div
        data-testid="choose-non-custodial"
        style="padding: 16px; border: 1px solid #d1d5db; border-radius: 6px; cursor: pointer;"
      >
        <h4
          style="margin: 0px; font-size: 15px; color: rgb(17, 24, 39);"
        >
          Option B: Connect Existing Stellar Wallet
        </h4>
        <p
          style="margin: 4px 0px 0px 0px; font-size: 13px; color: rgb(107, 114, 128);"
        >
          Link your existing public key (Freighter, Albedo, Lobstr, or Ledger).
        </p>
      </div>
    </div>
  </div>
</div>
`;

exports[`Stellar Web UI Components - Wallet & Reward State Snapshot Tests (#1047) WalletSetup (#1047) 2. Connect Form State: allows typing public key and validates input 1`] = `
<div>
  <div
    data-testid="wallet-setup-container"
    style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px; background-color: rgb(255, 255, 255);"
  >
    <h2
      style="font-size: 18px; font-weight: 600; margin-bottom: 8px;"
    >
      Set Up Your Stellar Wallet
    </h2>
    <p
      style="font-size: 14px; color: rgb(107, 114, 128); margin-bottom: 20px;"
    >
      Connect or create a Stellar account to receive queue incentive rewards directly on-chain.
    </p>
    <div
      role="alert"
      style="padding: 12px; background-color: rgb(254, 226, 226); color: rgb(153, 27, 27); border-radius: 6px; margin-bottom: 16px; font-size: 14px;"
    >
      Please provide a valid 56-character Stellar public key starting with G.
    </div>
    <div>
      <label
        for="stellar-public-key"
        style="display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px;"
      >
        Stellar Public Key (starts with G)
      </label>
      <input
        id="stellar-public-key"
        placeholder="GBRPYHIL2CI3FNQ4BXLFMNDLFJUNPU2HY3ZMFTGOBDKR3GYWUM7AZTQU"
        style="width: 100%; padding: 10px 12px; font-size: 14px; border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 16px; font-family: monospace;"
        type="text"
        value="invalid-stellar-key"
      />
      <div
        style="display: flex; gap: 8px;"
      >
        <button
          aria-busy="false"
          aria-disabled="false"
          data-testid="confirm-link-wallet"
          type="button"
        >
          Link Wallet
        </button>
        <button
          aria-busy="false"
          aria-disabled="false"
          style="background-color: rgb(243, 244, 246); color: rgb(55, 65, 81);"
          type="button"
        >
          Back
        </button>
      </div>
    </div>
  </div>
</div>
`;

