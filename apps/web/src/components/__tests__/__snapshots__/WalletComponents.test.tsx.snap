exports[`Stellar Web UI Components - Wallet & Reward State Snapshot Tests (#1047) RewardStatusIndicator (#1047) 4. Failed State: renders error message and retry button 1`] = `
<div>
  <div
    data-testid="reward-status-failed"
    style="border-radius: 8px; padding: 14px 18px; margin: 16px 0px; display: flex; align-items: center; justify-content: space-between; font-size: 14px; border: 1px solid #fecaca; background-color: rgb(254, 242, 242); color: rgb(153, 27, 27);"
  >
    <div
      style="display: flex; align-items: center; gap: 10px;"
    >
      <span
        style="font-size: 16px; font-weight: 700;"
      >
        ⚠
      </span>
      <div>
        <div>
          <strong>
            Reward Distribution Delayed
          </strong>
          <div
            style="font-size: 12px; color: rgb(185, 28, 28); margin-top: 2px;"
          >
            Insufficient contract pool balance
          </div>
        </div>
      </div>
    </div>
    <div
      style="display: flex; gap: 8px; align-items: center;"
    >
