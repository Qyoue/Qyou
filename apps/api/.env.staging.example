# Staging Environment Configuration - @qyou/api (#1071)
PORT=4000
NODE_ENV="staging"

# Database Configuration (Staging RDS / Cloud Postgres)
DATABASE_URL="postgresql://qyou_staging_user:secure_staging_password@staging-db.qyou.internal:5432/qyou_staging?schema=public"

# Auth & Security
JWT_SECRET="staging-super-secret-jwt-signing-key-minimum-32-chars-length"
JWT_EXPIRES_IN="1h"
BCRYPT_SALT_ROUNDS="12"

# Stellar & Soroban Testnet Configuration
ENABLE_STELLAR_INTEGRATION="true"
STELLAR_NETWORK="TESTNET"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Distribution Account (Funded via Friendbot on Testnet)
STELLAR_DISTRIBUTION_PUBLIC_KEY="GBRPYHIL2CI3FNQ4BXLFMNDLFJUNPU2HY3ZMFTGOBDKR3GYWUM7AZTQU"
# Load operational secret key from secret manager in deployment pipeline:
STELLAR_DISTRIBUTION_SECRET_KEY="SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Deployed Soroban Incentive Pool Contract on Testnet
