// ============================================================
// PASSWORD RESET SERVICE
// ============================================================

@Injectable()
export class PasswordResetService {

  /*
   * Reset links are intentionally short-lived.
   *
   * 15 minutes is a reasonable starting point.
   */

  private readonly RESET_TOKEN_TTL_MS =
    15 * 60 * 1000;

  /*
   * Number of bcrypt rounds.
   *
   * Adjust according to your production infrastructure.
   */

  private readonly BCRYPT_ROUNDS = 12;

  constructor(
    private readonly users:
      UserRepository,

    private readonly emailService:
      PasswordResetEmailService,
  ) {}

  // ==========================================================
  // FORGOT PASSWORD
  // ==========================================================

  async requestPasswordReset(
    email: string,
  ): Promise<PasswordResetResponse> {

    const normalizedEmail =
      this.normalizeEmail(email);

    /*
     * IMPORTANT SECURITY RULE:
     *
     * Do not reveal whether an email exists.
     *
     * Returning different messages for existing and
     * non-existing accounts enables account enumeration.
     */

    const genericResponse = {
      message:
        'If an account exists for this email, a password reset link has been sent.',
    };

    // --------------------------------------------------------
    // VALIDATE EMAIL FORMAT
    // --------------------------------------------------------

    if (
      !this.isValidEmail(
        normalizedEmail,
      )
    ) {
      /*
       * We still return the generic response instead of
       * revealing account information.
       */

      return genericResponse;
    }

    // --------------------------------------------------------
    // FIND USER
    // --------------------------------------------------------

    const user =
      await this.users.findByEmail(
        normalizedEmail,
      );

    if (!user) {
      return genericResponse;
    }

    // --------------------------------------------------------
    // GENERATE RESET TOKEN
    // --------------------------------------------------------

    const resetToken =
      this.generateResetToken();

    // --------------------------------------------------------
    // HASH TOKEN BEFORE STORAGE
    // --------------------------------------------------------

    /*
     * Never store the raw reset token in the database.
     *
     * If the database is compromised, an attacker should not
     * immediately be able to use stored reset tokens.
     */

    const tokenHash =
      this.hashResetToken(
        resetToken,
      );

    // --------------------------------------------------------
    // EXPIRATION
    // --------------------------------------------------------

    const expiresAt =
      new Date(
        Date.now() +
        this.RESET_TOKEN_TTL_MS,
      );

    // --------------------------------------------------------
    // SAVE TOKEN
    // --------------------------------------------------------

    await this.users.update(
      user.id,
      {
        passwordResetTokenHash:
          tokenHash,

        passwordResetExpiresAt:
          expiresAt,
      },
    );

    // --------------------------------------------------------
    // BUILD RESET URL
    // --------------------------------------------------------

    const resetUrl =
      this.buildResetUrl(
        resetToken,
      );

    // --------------------------------------------------------
    // SEND EMAIL
    // --------------------------------------------------------

    await this.emailService
      .sendPasswordResetEmail(
        user.email,
        resetUrl,
      );

    return genericResponse;
  }

  // ==========================================================
  // RESET PASSWORD
  // ==========================================================

  async resetPassword(
    token: string,
    newPassword: string,
    confirmPassword: string,
  ): Promise<PasswordResetResponse> {

    // --------------------------------------------------------
    // BASIC VALIDATION
    // --------------------------------------------------------

    if (!token) {
      throw new BadRequestException(
        'Reset token is required',
      );
    }

    if (!newPassword) {
      throw new BadRequestException(
        'New password is required',
      );
    }

    if (
      newPassword !== confirmPassword
    ) {
      throw new BadRequestException(
        'Passwords do not match',
      );
    }

    // --------------------------------------------------------
    // PASSWORD POLICY
    // --------------------------------------------------------

    this.validatePassword(
      newPassword,
    );

    // --------------------------------------------------------
    // HASH PROVIDED TOKEN
    // --------------------------------------------------------

    const tokenHash =
      this.hashResetToken(token);

    // --------------------------------------------------------
    // FIND USER
    // --------------------------------------------------------

    const user =
      await this.findUserByResetToken(
        tokenHash,
      );

    if (!user) {
      throw new BadRequestException(
        'Invalid or expired password reset token',
      );
    }

    // --------------------------------------------------------
    // VERIFY EXPIRATION
    // --------------------------------------------------------

    if (
      !user.passwordResetExpiresAt ||
      user.passwordResetExpiresAt
        .getTime() <= Date.now()
    ) {

      /*
       * Clear expired token.
       */

      await this.users.update(
        user.id,
        {
          passwordResetTokenHash:
            undefined,

          passwordResetExpiresAt:
            undefined,
        },
      );

      throw new BadRequestException(
        'Invalid or expired password reset token',
      );
    }

    // --------------------------------------------------------
    // HASH NEW PASSWORD
    // --------------------------------------------------------

    const passwordHash =
      await bcrypt.hash(
        newPassword,
        this.BCRYPT_ROUNDS,
      );

    // --------------------------------------------------------
    // UPDATE PASSWORD
    // --------------------------------------------------------

    await this.users.update(
      user.id,
      {
        passwordHash,

        /*
         * IMPORTANT:
         *
         * The reset token is immediately invalidated after
         * successful use.
         */

        passwordResetTokenHash:
          undefined,

        passwordResetExpiresAt:
          undefined,

        passwordChangedAt:
          new Date(),
      },
    );

    // --------------------------------------------------------
    // RETURN SUCCESS
    // --------------------------------------------------------

    return {
      message:
        'Password has been reset successfully.',
    };
  }

  // ==========================================================
  // FIND USER BY RESET TOKEN
  // ==========================================================

  private async findUserByResetToken(
    tokenHash: string,
  ): Promise<User | null> {

    /*
     * A production repository should have an indexed
     * passwordResetTokenHash column and query it directly.
     *
     * This implementation uses a repository extension below
     * for demonstration purposes.
     */

    const repository =
      this.users as
        InMemoryUserRepository;

    /*
     * The generic repository interface intentionally doesn't
     * expose reset-token lookup.
     *
     * In a real application, add:
     *
     * findByPasswordResetTokenHash()
     *
     * to the repository interface.
     */

    if (
      typeof
      (repository as any)
        .findByResetTokenHash ===
      'function'
    ) {

      return (
        await (
          repository as any
        ).findByResetTokenHash(
          tokenHash,
        )
      );
    }

    return null;
  }

  // ==========================================================
  // GENERATE RESET TOKEN
  // ==========================================================

  private generateResetToken(): string {

    /*
     * 32 random bytes = 256 bits of entropy.
     */

    return crypto
      .randomBytes(32)
      .toString('hex');
  }

  // ==========================================================
  // HASH RESET TOKEN
  // ==========================================================

  private hashResetToken(
    token: string,
  ): string {

    return crypto
      .createHash('sha256')
      .update(token)
      .digest('hex');
  }

  // ==========================================================
  // NORMALIZE EMAIL
  // ==========================================================

  private normalizeEmail(
    email: string,
  ): string {

    return email
      .trim()
      .toLowerCase();
  }

  // ==========================================================
  // EMAIL VALIDATION
  // ==========================================================

  private isValidEmail(
    email: string,
  ): boolean {

    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/
      .test(email);
  }

  // ==========================================================
  // PASSWORD VALIDATION
  // ==========================================================

  private validatePassword(
    password: string,
  ): void {

    if (
      password.length < 12
    ) {
      throw new BadRequestException(
        'Password must contain at least 12 characters',
      );
    }

    if (
      password.length > 128
    ) {
      throw new BadRequestException(
        'Password must not exceed 128 characters',
      );
    }

    if (
      !/[A-Z]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain an uppercase letter',
      );
    }

    if (
      !/[a-z]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain a lowercase letter',
      );
    }

    if (
      !/[0-9]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain a number',
      );
    }

    if (
      !/[^A-Za-z0-9]/.test(password)
    ) {
      throw new BadRequestException(
        'Password must contain a special character',
      );
    }
  }

  // ==========================================================
  // BUILD RESET URL
  // ==========================================================

  private buildResetUrl(
    token: string,
  ): string {

    const frontendUrl =
      process.env.FRONTEND_URL ??
      'http://localhost:3000';

    return (
      `${frontendUrl}/reset-password?token=${encodeURIComponent(token)}`
    );
  }
}

// ============================================================
// EXTENDED IN-MEMORY REPOSITORY
// ============================================================

/*
 * Add reset-token lookup to the demonstration repository.
 */

export interface ResetTokenRepository
  extends UserRepository {

  findByResetTokenHash(
    tokenHash: string,
  ): Promise<User | null>;
}

@Injectable()
export class ExtendedInMemoryUserRepository
  extends InMemoryUserRepository
  implements ResetTokenRepository {

  async findByResetTokenHash(
    tokenHash: string,
  ): Promise<User | null> {

    /*
     * This is only a demonstration implementation.
     *
     * A real database should query:
     *
     * WHERE password_reset_token_hash = ?
     */

    const users =
      (this as any).users as
        Map<string, User>;

    for (
      const user
      of users.values()
    ) {

      if (
        user.passwordResetTokenHash ===
        tokenHash
      ) {
        return user;
      }
    }

    return null;
  }
}

// ============================================================
// PASSWORD RESET CONTROLLER
// ============================================================

@Controller('auth')
export class PasswordResetController {

  constructor(
    private readonly passwordResetService:
      PasswordResetService,
  ) {}

  // ==========================================================
  // FORGOT PASSWORD ENDPOINT
  // ==========================================================

  @Post('forgot-password')
  async forgotPassword(
    @Body()
    dto: ForgotPasswordDto,
  ): Promise<PasswordResetResponse> {

    return this.passwordResetService
      .requestPasswordReset(
        dto.email,
      );
  }

  // ==========================================================
  // RESET PASSWORD ENDPOINT
  // ==========================================================

  @Post('reset-password')
  async resetPassword(
    @Body()
    dto: ResetPasswordDto,
  ): Promise<PasswordResetResponse> {

    return this.passwordResetService
      .resetPassword(
        dto.token,
        dto.newPassword,
        dto.confirmPassword,
      );
  }
}

