// ============================================================
// REQUEST FLOW
// ============================================================

/*
 *
 *                  FORGOT PASSWORD
 *
 * User
 *   |
 *   v
 * POST /auth/forgot-password
 *   |
 *   v
 * Normalize email
 *   |
 *   v
 * Find account
 *   |
 *   +---- Not found
 *   |       |
 *   |       v
 *   |   Generic response
 *   |
 *   v
 * Generate 256-bit random token
 *   |
 *   v
 * SHA-256 hash token
 *   |
 *   v
 * Store hash + expiration
 *   |
 *   v
 * Send raw token by email
 *   |
 *   v
 * Generic response
 *
 *
 *
 *                  RESET PASSWORD
 *
 * User clicks email
 *       |
 *       v
 * POST /auth/reset-password
 *       |
 *       v
 * Hash supplied token
 *       |
 *       v
 * Find matching hash
 *       |
 *       +---- Invalid ---> 400
 *       |
 *       v
 * Check expiration
 *       |
 *       +---- Expired ---> 400
 *       |
 *       v
 * Validate new password
 *       |
 *       v
 * Hash new password
 *       |
 *       v
 * Update password
 *       |
 *       v
 * DELETE reset token
 *       |
 *       v
 * Success
 */

// ============================================================
// SECURITY REQUIREMENTS
// ============================================================

/*
 *
 * 1. NEVER store raw reset tokens.
 *
 * 2. Use cryptographically secure random tokens.
 *
 * 3. Give tokens a short expiration period.
 *
 * 4. Make reset tokens single-use.
 *
 * 5. Return the same response for existing and
 *    non-existing email addresses.
 *
 * 6. Rate-limit the forgot-password endpoint.
 *
 * 7. Rate-limit reset attempts.
 *
 * 8. Use HTTPS in production.
 *
 * 9. Do not put passwords in URLs.
 *
 * 10. Do not log reset tokens.
 *
 * 11. Do not log new passwords.
 *
 * 12. Invalidate the reset token immediately after
 *     successful password reset.
 *
 * 13. Consider invalidating existing sessions after
 *     a successful password reset.
 *
 * 14. Use a strong password hashing algorithm such as
 *     Argon2id or appropriately configured bcrypt.
 *
 */

// ============================================================
// OPTIONAL SESSION INVALIDATION
// ============================================================

/*
 * If your application has refresh tokens/sessions, the
 * password reset should invalidate them.
 *
 * For example:
 *
 * await sessions.deleteAllForUser(user.id);
 *
 * or increment a token version:
 *
 * user.tokenVersion += 1;
 *
 * Existing JWT/session tokens can then be rejected when
 * their token version no longer matches the user's version.
 */

